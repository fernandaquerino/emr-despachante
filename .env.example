# Placeholder — nenhuma variável real de segredo deve ser commitada aqui.
# Preenchido conforme apps precisarem (DB, Redis, AWS, LLM provider) em issues futuras.
NODE_ENV=development

# PostgreSQL local (docker-compose.yml)
POSTGRES_USER=emr
POSTGRES_PASSWORD=emr
POSTGRES_DB=emr_despachante
# 5434 (não 5432) para não colidir com um PostgreSQL local ou outro projeto já usando a porta padrão.
POSTGRES_PORT=5434

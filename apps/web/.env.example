# Somente variáveis NEXT_PUBLIC_* podem ser expostas ao navegador. Nunca use esse prefixo para secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Opcional. Só dígitos, formato internacional (ex.: 5511987654321). Sem essa
# variável, o CTA flutuante de WhatsApp não é renderizado.
NEXT_PUBLIC_WHATSAPP_NUMBER=

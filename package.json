{
  "name": "emr-despachante",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel --filter=\"./apps/*\" run dev",
    "storybook": "pnpm --filter @emr/ui storybook",
    "build": "pnpm -r --filter=\"./apps/*\" --filter=\"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --if-present run test",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "format:check": "prettier --check .",
    "start": "pnpm -r --parallel --filter=\"./apps/*\" run start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @emr/api run db:migrate",
    "db:migrate:deploy": "pnpm --filter @emr/api run db:migrate:deploy",
    "db:seed": "pnpm --filter @emr/api run db:seed",
    "db:reset": "pnpm --filter @emr/api run db:reset",
    "db:studio": "pnpm --filter @emr/api run db:studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
